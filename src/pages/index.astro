---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../about.md';
import Reading from '../reading.md';

// Pull in every writing post to show as excerpts below the About text.
const modules = import.meta.glob('./writing/*.md', { eager: true });

const posts = Object.values(modules)
  .map((mod) => ({
    url: mod.url,
    ...mod.frontmatter,
  }))
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());

const fmt = (d) =>
  new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout title="Nicole Chen">
  <div class="intro">
    <div class="intro-text">
      <About />
    </div>
    <div class="intro-photos">
      <img src="/images/me.png" alt="Nicole Chen" class="profile-photo" />
      <img src="/images/photo-1.png" alt="Harvard graduation" class="stacked-photo" />
      <img src="/images/photo-2.png" alt="Squash team" class="stacked-photo" />
    </div>
  </div>

  <section class="feed">
    {/* CSS-only toggle: the checked radio decides which panel shows. */}
    <input type="radio" name="feed" id="feed-writing" class="feed-input" checked />
    <input type="radio" name="feed" id="feed-reading" class="feed-input" />

    <div class="feed-tabs">
      <label for="feed-writing">Writing</label>
      <span class="feed-sep">|</span>
      <label for="feed-reading">Reading</label>
    </div>

    <ul class="post-list feed-panel panel-writing">
      {posts.map((post) => (
        <li>
          <a href={post.url}>{post.title}</a>
          {post.description && <div class="post-excerpt">{post.description}</div>}
        </li>
      ))}
    </ul>

    <div class="feed-panel panel-reading reading-list">
      <Reading />
    </div>
  </section>
</BaseLayout>
